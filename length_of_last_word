class Solution(object):
    def lengthOfLastWord(self, s):
        """
        :type s: str
        :rtype: int
        """
        
        strs = s.split(" ")
        length=len(strs)
        # if(length==1):
        #     return len(strs[0])
        for i in range(length-1,-1,-1):
            if (len(strs[i])>0):
                return len(strs[i])

