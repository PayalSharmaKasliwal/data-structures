class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        pop_map={
                ")":"(",
                "}":"{",
                "]":"["
                    }

        stack=[d for d in s]

        stack_new=[]
        for i in range(len(stack)):
            if(stack[i] in pop_map.values()):
                stack_new.append(stack[i])
            elif(len(stack_new)>0 and stack_new[len(stack_new)-1]==pop_map[stack[i]]):
                stack_new.pop()
            else:
                stack_new.append(stack[i])

        if len(stack_new)==0:
            return True
        else:
            return False
                    
